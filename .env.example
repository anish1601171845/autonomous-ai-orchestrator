# ---- LLM (optional). Empty key => deterministic template backends for scoping and code generation.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1      # any OpenAI-compatible endpoint, e.g. http://localhost:11434/v1 for Ollama
LLM_MODEL=gpt-6-astra
LLM_TIMEOUT_S=60

# ---- Semantic encoder: tfidf (default, offline) | auto | transformer
# If you switch to a transformer (e.g. bert-base-uncased, roberta-base, sentence-transformers/all-MiniLM-L6-v2),
# re-run `python scripts/train_all.py` so the GNN is trained on the same embeddings.
SEMANTIC_BACKEND=tfidf
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- GitHub (read-only unless GITHUB_WRITE_ENABLED=true AND a human approves the workflow)
GITHUB_TOKEN=
GITHUB_REPO=anish1601171845/SalesForecasting
GITHUB_WRITE_ENABLED=true

# ---- Storage / runtime
# DATABASE_URL=sqlite:///orchestrator.db     # default: orchestrator.db in the project folder; or postgresql+psycopg://user:pass@host/db
# WORKSPACE_DIR=                            # default: the project's workspace/ folder
API_URL=http://localhost:8000
SCHEDULER=auto                              # auto | rl_ppo | least_loaded | round_robin
MAX_QA_RETRIES=2
ALLOW_SANDBOX_EXECUTION=true
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=1024
LOG_LEVEL=INFO

# ---- AegisFlow enhancements (each can be switched off independently)
MEMORY_ENABLED=true
MEMORY_BACKEND=auto                         # auto (embeddings if the model loads, else TF-IDF) | embedding | tfidf
MEMORY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_TOP_K=3
MEMORY_MIN_SCORE=0.25
# MEMORY_INDEX_DIR=                         # default: data/memory_index (Docker: /app/var/memory_index)
RISK_ENABLED=true
RISK_MEDIUM_THRESHOLD=0.15
RISK_HIGH_THRESHOLD=0.35
DEBATE_ENABLED=true
DEBATE_MAX_ROUNDS=3                         # hard cap 3
DEBATE_TIME_BUDGET_S=60
DEBATE_TOKEN_BUDGET=12000
LLM_COST_PER_1K_TOKENS=0.0006
RECOVERY_MODE=full                          # none | fixed_retry | checkpoint | full
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_S=0.5
RETRY_MAX_DELAY_S=8
MAX_WORKFLOW_RESUMES=2
